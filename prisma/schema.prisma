// Atlas data model. Vector + tsvector columns are maintained by hand-written SQL
// (see prisma/migrations/*_search_and_vectors). Never edit those columns via Prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncTier {
  HOT
  WARM
  COLD
}

enum NodeType {
  NICHE
  SUBNICHE
  CHANNEL
  VIDEO
  TOPIC
}

enum EdgeKind {
  CONTAINS
  IN_NICHE
  PUBLISHED
  MENTIONS
  CHANNEL_TOPIC
  FEATURED
  SIMILAR
  CO_TOPIC
  TOPIC_RELATED
  NICHE_TOPIC
  CO_DISCOVERED
}

enum ClassMethod {
  RULES
  EMBEDDING
  AI
  MANUAL
}

enum TranscriptSource {
  OWNER_CAPTIONS
  USER_UPLOAD
  THIRD_PARTY
  FIXTURE
}

enum Role {
  USER
  ADMIN
}

/// Where a channel's records came from. FIXTURE = the fictional demo dataset (never real YouTube data).
enum DataOrigin {
  YOUTUBE
  FIXTURE
}

enum TranscriptVisibility {
  PRIVATE // only the owner (uploader / authorizing user)
  CORPUS // shared corpus (fixture/demo only today)
}

enum TranscriptKind {
  MANUAL
  ASR
  UPLOADED
  FIXTURE
}

enum TranscriptStatus {
  NOT_CHECKED
  PENDING
  AVAILABLE
  NOT_AVAILABLE
  FAILED
  REQUIRES_USER_UPLOAD
  NOT_ELIGIBLE_OWNER_CAPTIONS
}

enum CoverageGroup {
  IDENTITY
  TEXT
  CHANNEL_PROFILE
  THUMBNAILS
  PUBLICATION
  STATISTICS
  STATUS
  TRANSCRIPT
}

enum CoverageStatus {
  PRESENT
  NOT_RETURNED
  UNAVAILABLE
  NOT_APPLICABLE
  NOT_REQUESTED
  STALE
  ERROR
  EXPIRED
}

enum RetentionClass {
  API_METADATA
  API_STATISTICS
  AUTHORIZED_DATA
  USER_CONTENT
  FIXTURE
}

enum HistoryState {
  NOT_STARTED
  INITIAL_WINDOW_COLLECTED
  BACKFILL_IN_PROGRESS
  PAUSED_AWAITING_APPROVAL
  COMPLETE_TO_SOURCE_LIMIT
  FAILED_RETRYABLE
  SOURCE_UNAVAILABLE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProposalSource {
  USER
  CLAUDE
  SYSTEM
  CLI
}

enum ExpansionKind {
  ADD_CHANNELS
  DISCOVER_CHANNELS
  BACKFILL_HISTORY
  SYNC_UPLOADS
  REFRESH_METADATA
}

// ───────────────────────────── YouTube corpus ─────────────────────────────

model Channel {
  id                    String                      @id @default(cuid())
  youtubeId             String                      @unique
  handle                String?                     @unique
  title                 String
  description           String                      @default("")
  customUrl             String?
  country               String?
  publishedAt           DateTime?
  thumbnailUrl          String?
  /// All thumbnail variants [{ variant, url, width, height }] (see youtube/normalize.ts)
  thumbnails            Json                        @default("[]")
  defaultLanguage       String?
  localizations         Json?
  keywords              String[]
  topicCategories       String[]
  topicIds              String[]
  madeForKids           Boolean?
  privacyStatus         String?
  isLinked              Boolean?
  trailerVideoId        String?
  subscriberCount       BigInt?
  hiddenSubscriberCount Boolean                     @default(false)
  videoCount            Int?
  viewCount             BigInt?
  uploadsPlaylistId     String?
  etag                  String?
  syncTier              SyncTier                    @default(WARM)
  lastSyncedAt          DateTime?
  lastStatsAt           DateTime?
  lastRefreshedAt       DateTime?
  lastViewedAt          DateTime?
  latestVideoAt         DateTime?
  featuredChannelIds    String[]
  isAvailable           Boolean                     @default(true)
  /// Set at ingest from YOUTUBE_MODE; lets live deployments detect and retire demo records (pnpm demo:retire).
  dataOrigin            DataOrigin                  @default(YOUTUBE)
  embeddingHash         String?
  embedding             Unsupported("vector(384)")?
  searchVector          Unsupported("tsvector")?
  videos                Video[]
  niches                ChannelNiche[]
  aliases               ChannelAlias[]
  history               UploadHistory?
  coverage              FieldCoverage[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_title_trgm_idx")
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_handle_trgm_idx")
  @@index([lastRefreshedAt])
  @@index([dataOrigin])
  @@index([searchVector], type: Gin, map: "Channel_searchVector_idx")
}

model ChannelAlias {
  id        String  @id @default(cuid())
  channelId String
  kind      String
  value     String  @unique
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Video {
  id                   String                      @id @default(cuid())
  youtubeId            String                      @unique
  channelId            String
  title                String
  description          String                      @default("")
  publishedAt          DateTime
  durationSec          Int?
  tags                 String[]
  categoryId           String?
  channelTitle         String?
  defaultLanguage      String?
  defaultAudioLanguage String?
  thumbnailUrl         String?
  thumbnails           Json                        @default("[]")
  liveBroadcastContent String?
  liveScheduledStartAt DateTime?
  liveActualStartAt    DateTime?
  liveActualEndAt      DateTime?
  definition           String?
  dimension            String?
  projection           String?
  /// contentDetails.caption: whether YouTube reports caption tracks exist (not whether Atlas can access them)
  captionFlag          Boolean?
  licensedContent      Boolean?
  regionRestriction    Json?
  contentRating        Json?
  privacyStatus        String?
  uploadStatus         String?
  license              String?
  embeddable           Boolean?
  publicStatsViewable  Boolean?
  madeForKids          Boolean?
  topicCategories      String[]
  localizations        Json?
  viewCount            BigInt?
  likeCount            BigInt?
  commentCount         BigInt?
  isShort              Boolean                     @default(false)
  etag                 String?
  lastStatsAt          DateTime?
  lastRefreshedAt      DateTime?
  isAvailable          Boolean                     @default(true)
  /// A CORPUS-visible transcript exists (private transcripts never set this).
  hasTranscript        Boolean                     @default(false)
  transcriptStatus     TranscriptStatus            @default(NOT_CHECKED)
  topicsAt             DateTime?
  embeddingHash        String?
  embedding            Unsupported("vector(384)")?
  searchVector         Unsupported("tsvector")?
  channel              Channel                     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  transcripts          Transcript[]
  topics               VideoTopic[]
  niches               VideoNiche[]
  coverage             FieldCoverage[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([channelId, publishedAt(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Video_title_trgm_idx")
  @@index([lastRefreshedAt])
  @@index([searchVector], type: Gin, map: "Video_searchVector_idx")
}

model Transcript {
  id              String               @id @default(cuid())
  videoId         String
  source          TranscriptSource
  visibility      TranscriptVisibility @default(PRIVATE)
  /// Uploading user (USER_UPLOAD) or authorizing user (OWNER_CAPTIONS). Null only for CORPUS transcripts.
  ownerUserId     String?
  /// ownerUserId ?? "corpus" — non-null so the uniqueness key works (NULLs are distinct in Postgres).
  ownerKey        String
  connectionId    String?
  providerTrackId String?
  language        String
  trackKind       TranscriptKind
  isAutoGenerated Boolean              @default(false)
  contentHash     String
  fetchedAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  video           Video                @relation(fields: [videoId], references: [id], onDelete: Cascade)
  owner           User?                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection      YouTubeConnection?   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  chunks          TranscriptChunk[]

  @@unique([videoId, source, language, ownerKey])
  @@index([videoId, visibility])
  @@index([ownerUserId])
  @@index([connectionId])
}

model TranscriptChunk {
  id           String                      @id @default(cuid())
  transcriptId String
  idx          Int
  startSec     Float
  endSec       Float
  text         String
  embedding    Unsupported("vector(384)")?
  searchVector Unsupported("tsvector")?
  transcript   Transcript                  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, idx])
  @@index([searchVector], type: Gin, map: "TranscriptChunk_searchVector_idx")
}

model Niche {
  id               String                      @id @default(cuid())
  slug             String                      @unique
  name             String
  description      String                      @default("")
  keywords         String[]
  discoveryQueries String[]
  parentId         String?
  depth            Int                         @default(0)
  centroid         Unsupported("vector(384)")?
  centroidCount    Int                         @default(0)
  channelCount     Int                         @default(0)
  videoCount       Int                         @default(0)
  /// SEED = predefined demo taxonomy, DYNAMIC = generated from corpus evidence, MANUAL = created by a user
  origin           NicheOrigin                 @default(SEED)
  status           NicheStatus                 @default(ACTIVE)
  /// Generated categories record the run that created them (provenance) and a bootstrap flag to revisit.
  createdByRunId   String?
  bootstrap        Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @default(now()) @updatedAt
  parent           Niche?                      @relation("NicheTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         Niche[]                     @relation("NicheTree")
  channels         ChannelNiche[]
  videos           VideoNiche[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Niche_name_trgm_idx")
  @@index([origin, status])
}

enum NicheOrigin {
  SEED
  DYNAMIC
  MANUAL
}

enum NicheStatus {
  ACTIVE
  PROVISIONAL
  RETIRED
}

/// Authoritative taxonomy evidence: which videos place content in which subniche, and why.
/// ChannelNiche is a projection aggregated from these rows (MANUAL channel assignments still win).
model VideoNiche {
  videoId         String
  nicheId         String
  confidence      Float
  /// REUSE (nearest existing category) | CREATE (founding member of a new category) | MANUAL
  decision        String
  rationale       String?
  /// { cosine, topics[], titleTerms[], neighbours? }
  evidence        Json?
  contentHash     String?
  model           String?
  promptVersion   String?
  taxonomyVersion Int      @default(1)
  runId           String?
  createdAt       DateTime @default(now())
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  niche           Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([videoId, nicheId])
  @@index([nicheId, confidence])
}

model TaxonomyRun {
  id         String    @id @default(cuid())
  /// BOOTSTRAP | INCREMENTAL | SHADOW
  kind       String
  status     String    @default("RUNNING")
  params     Json      @default("{}")
  stats      Json      @default("{}")
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

model ChannelNiche {
  channelId     String
  nicheId       String
  confidence    Float
  method        ClassMethod
  rationale     String?
  lowConfidence Boolean     @default(false)
  createdAt     DateTime    @default(now())
  channel       Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  niche         Niche       @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([channelId, nicheId])
  @@index([nicheId, confidence])
}

model Topic {
  id           String                      @id @default(cuid())
  slug         String                      @unique
  label        String
  aliases      String[]
  videoCount   Int                         @default(0)
  channelCount Int                         @default(0)
  embedding    Unsupported("vector(384)")?
  searchVector Unsupported("tsvector")?
  videos       VideoTopic[]

  @@index([label(ops: raw("gin_trgm_ops"))], type: Gin, map: "Topic_label_trgm_idx")
  @@index([searchVector], type: Gin, map: "Topic_searchVector_idx")
}

model VideoTopic {
  videoId     String
  topicId     String
  weight      Float
  source      String
  /// Which source fields / transcript chunks support the topic, extractor version, confidence
  evidence    Json?
  extractor   String?
  extractedAt DateTime @default(now())
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([videoId, topicId])
  @@index([topicId, weight])
}

// ─────────────────────────── Materialized graph ───────────────────────────

model GraphNode {
  id          String   @id
  type        NodeType
  refId       String
  label       String
  size        Float    @default(1)
  communityId Int?
  attrs       Json     @default("{}")
  version     BigInt
  updatedAt   DateTime @updatedAt

  @@unique([type, refId])
  @@index([version])
}

model GraphEdge {
  id        String   @id
  sourceId  String
  targetId  String
  kind      EdgeKind
  weight    Float
  evidence  Json?
  version   BigInt
  updatedAt DateTime @updatedAt

  @@unique([sourceId, targetId, kind])
  @@index([sourceId, kind, weight])
  @@index([targetId, kind])
  @@index([version])
}

model GraphTombstone {
  id        String   @id @default(cuid())
  kind      String // "node" | "edge"
  refId     String
  version   BigInt
  createdAt DateTime @default(now())

  @@index([version])
}

// ───────────────────────────── Personal layer ─────────────────────────────

model Workspace {
  id          String       @id @default(cuid())
  ownerId     String
  name        String
  description String?
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections Collection[]
  savedViews  SavedView[]
  layouts     NodeLayout[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

model Collection {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String           @default("#4361FF")
  icon        String           @default("folder")
  sortOrder   Int              @default(0)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, sortOrder])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  nodeId       String
  note         String?
  tags         String[]
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, nodeId])
  @@index([nodeId])
}

model SavedView {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  state       Json
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model NodeLayout {
  workspaceId String
  nodeId      String
  x           Float
  y           Float
  pinned      Boolean   @default(true)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, nodeId])
}

// ─────────────────────────────────── Ops ──────────────────────────────────

model DiscoveryQuery {
  id               String   @id @default(cuid())
  userId           String?
  query            String
  nicheId          String?
  resultChannelIds String[]
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model IngestionRun {
  id          String    @id @default(cuid())
  kind        String
  targetId    String
  status      String
  unitsUsed   Int       @default(0)
  searchCalls Int       @default(0)
  requestedBy String?
  proposalId  String?
  jobId       String?
  scopeHash   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?
  stats       Json      @default("{}")

  @@index([proposalId])
  @@index([targetId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

model YouTubeConnection {
  id               String       @id @default(cuid())
  userId           String       @unique
  googleSub        String
  channelIds       String[]
  accessTokenEnc   String
  refreshTokenEnc  String?
  scope            String
  expiresAt        DateTime
  lastValidatedAt  DateTime?
  lastRefreshError String?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcripts      Transcript[]
}

// ───────────────────── Coverage, history, governance ─────────────────────

/// Field-group coverage for one channel or video: what was collected, when, why something is missing, and when it
/// must be refreshed or deleted. Exactly one of channelId / videoId is set.
model FieldCoverage {
  id                String         @id @default(cuid())
  channelId         String?
  videoId           String?
  group             CoverageGroup
  status            CoverageStatus
  source            String
  reason            String?
  details           Json?
  retentionClass    RetentionClass
  lastAttemptAt     DateTime
  lastSuccessAt     DateTime?
  retentionDeadline DateTime?
  error             String?
  updatedAt         DateTime       @updatedAt
  channel           Channel?       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  video             Video?         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([channelId, group])
  @@unique([videoId, group])
  @@index([group, status])
  @@index([retentionDeadline])
}

/// Checkpointed upload-history collection for a channel (uploads playlist, newest → oldest).
model UploadHistory {
  channelId         String       @id
  state             HistoryState @default(NOT_STARTED)
  /// Token of the next page to read (null = first page) + how many items of that page were already consumed.
  nextPageToken     String?
  pageOffset        Int          @default(0)
  pagesScanned      Int          @default(0)
  itemsSeen         Int          @default(0)
  videosCollected   Int          @default(0)
  unavailableCount  Int          @default(0)
  oldestPublishedAt DateTime?
  newestPublishedAt DateTime?
  /// Sync watermark: every upload published at/before this (down to the history scan) is known to be collected.
  /// Advanced only by a sync/scan that completed without hitting its bound, so bounded or failed syncs never leave gaps.
  syncWatermark     DateTime?
  totalResults      Int?
  lastPageAt        DateTime?
  completedAt       DateTime?
  lastError         String?
  lastProposalId    String?
  updatedAt         DateTime     @updatedAt
  channel           Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

/// A bounded, immutable request to expand or refresh the corpus. Executes only after explicit, single-use approval
/// by a human; services, queue producers and workers all re-validate it (services/expansion).
model ExpansionProposal {
  id                   String         @id @default(cuid())
  createdByUserId      String?
  source               ProposalSource
  kind                 ExpansionKind
  targetType           String
  targetIds            String[]
  scope                Json
  scopeHash            String
  title                String
  reason               String
  coverageGap          String?
  uncertainty          String?
  estimatedChannels    Int
  estimatedVideos      Int
  estimatedQuota       Int
  estimatedSearchCalls Int
  status               ProposalStatus @default(PENDING)
  expiresAt            DateTime
  approvedByUserId     String?
  approvedAt           DateTime?
  decidedByUserId      String?
  decidedAt            DateTime?
  decisionNote         String?
  executionDeadline    DateTime?
  startedAt            DateTime?
  finishedAt           DateTime?
  jobIds               String[]
  doneJobIds           String[]
  failedJobIds         String[]
  actualResults        Json           @default("{}")
  actualQuota          Int            @default(0)
  actualSearchCalls    Int            @default(0)
  error                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  createdBy            User?          @relation("ProposalCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy           User?          @relation("ProposalApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([createdByUserId, status])
  @@index([kind, status])
}

model AiExtraction {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  contentHash String
  model       String
  output      Json
  tokensIn    Int
  tokensOut   Int
  createdAt   DateTime @default(now())

  @@unique([targetType, targetId, contentHash])
}

// ─────────────────────────────── Better Auth ──────────────────────────────

model User {
  id                String              @id
  name              String
  email             String              @unique
  emailVerified     Boolean             @default(false)
  image             String?
  role              Role                @default(USER)
  reducedMotion     Boolean             @default(false)
  defaultLayout     String              @default("global")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          Session[]
  accounts          Account[]
  workspaces        Workspace[]
  discoveryQueries  DiscoveryQuery[]
  youtubeConnection YouTubeConnection?
  transcripts       Transcript[]
  proposalsCreated  ExpansionProposal[] @relation("ProposalCreator")
  proposalsApproved ExpansionProposal[] @relation("ProposalApprover")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
