// Atlas data model. Vector + tsvector columns are maintained by hand-written SQL
// (see prisma/migrations/*_search_and_vectors). Never edit those columns via Prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncTier {
  HOT
  WARM
  COLD
}

enum NodeType {
  NICHE
  SUBNICHE
  CHANNEL
  VIDEO
  TOPIC
}

enum EdgeKind {
  CONTAINS
  IN_NICHE
  PUBLISHED
  MENTIONS
  CHANNEL_TOPIC
  FEATURED
  SIMILAR
  CO_TOPIC
  TOPIC_RELATED
  NICHE_TOPIC
  CO_DISCOVERED
}

enum ClassMethod {
  RULES
  EMBEDDING
  AI
  MANUAL
}

enum TranscriptSource {
  OWNER_CAPTIONS
  USER_UPLOAD
  THIRD_PARTY
  FIXTURE
}

enum Role {
  USER
  ADMIN
}

// ───────────────────────────── YouTube corpus ─────────────────────────────

model Channel {
  id                    String                    @id @default(cuid())
  youtubeId             String                    @unique
  handle                String?                   @unique
  title                 String
  description           String                    @default("")
  customUrl             String?
  country               String?
  publishedAt           DateTime?
  thumbnailUrl          String?
  keywords              String[]
  topicCategories       String[]
  subscriberCount       BigInt?
  hiddenSubscriberCount Boolean                   @default(false)
  videoCount            Int?
  viewCount             BigInt?
  uploadsPlaylistId     String?
  etag                  String?
  syncTier              SyncTier                  @default(WARM)
  lastSyncedAt          DateTime?
  lastStatsAt           DateTime?
  lastRefreshedAt       DateTime?
  lastViewedAt          DateTime?
  latestVideoAt         DateTime?
  backfillPageToken     String?
  featuredChannelIds    String[]
  isAvailable           Boolean                   @default(true)
  embeddingHash         String?
  embedding             Unsupported("vector(384)")?
  searchVector          Unsupported("tsvector")?
  videos                Video[]
  niches                ChannelNiche[]
  aliases               ChannelAlias[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_title_trgm_idx")
  @@index([handle(ops: raw("gin_trgm_ops"))], type: Gin, map: "Channel_handle_trgm_idx")
  @@index([lastRefreshedAt])
  @@index([searchVector], type: Gin, map: "Channel_searchVector_idx")
}

model ChannelAlias {
  id        String  @id @default(cuid())
  channelId String
  kind      String
  value     String  @unique
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

model Video {
  id              String                      @id @default(cuid())
  youtubeId       String                      @unique
  channelId       String
  title           String
  description     String                      @default("")
  publishedAt     DateTime
  durationSec     Int?
  tags            String[]
  categoryId      String?
  defaultLanguage String?
  thumbnailUrl    String?
  viewCount       BigInt?
  likeCount       BigInt?
  commentCount    BigInt?
  isShort         Boolean                     @default(false)
  etag            String?
  lastStatsAt     DateTime?
  lastRefreshedAt DateTime?
  isAvailable     Boolean                     @default(true)
  hasTranscript   Boolean                     @default(false)
  topicsAt        DateTime?
  embeddingHash   String?
  embedding       Unsupported("vector(384)")?
  searchVector    Unsupported("tsvector")?
  channel         Channel                     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  transcript      Transcript?
  topics          VideoTopic[]
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([channelId, publishedAt(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Video_title_trgm_idx")
  @@index([lastRefreshedAt])
  @@index([searchVector], type: Gin, map: "Video_searchVector_idx")
}

model Transcript {
  id              String            @id @default(cuid())
  videoId         String            @unique
  source          TranscriptSource
  language        String
  isAutoGenerated Boolean           @default(false)
  contentHash     String
  fetchedAt       DateTime          @default(now())
  uploadedById    String?
  video           Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  chunks          TranscriptChunk[]
}

model TranscriptChunk {
  id           String                      @id @default(cuid())
  transcriptId String
  idx          Int
  startSec     Float
  endSec       Float
  text         String
  embedding    Unsupported("vector(384)")?
  searchVector Unsupported("tsvector")?
  transcript   Transcript                  @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, idx])
  @@index([searchVector], type: Gin, map: "TranscriptChunk_searchVector_idx")
}

model Niche {
  id               String                      @id @default(cuid())
  slug             String                      @unique
  name             String
  description      String                      @default("")
  keywords         String[]
  discoveryQueries String[]
  parentId         String?
  depth            Int                         @default(0)
  centroid         Unsupported("vector(384)")?
  centroidCount    Int                         @default(0)
  channelCount     Int                         @default(0)
  parent           Niche?                      @relation("NicheTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         Niche[]                     @relation("NicheTree")
  channels         ChannelNiche[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Niche_name_trgm_idx")
}

model ChannelNiche {
  channelId     String
  nicheId       String
  confidence    Float
  method        ClassMethod
  rationale     String?
  lowConfidence Boolean     @default(false)
  createdAt     DateTime    @default(now())
  channel       Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  niche         Niche       @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@id([channelId, nicheId])
  @@index([nicheId, confidence])
}

model Topic {
  id           String                      @id @default(cuid())
  slug         String                      @unique
  label        String
  aliases      String[]
  videoCount   Int                         @default(0)
  channelCount Int                         @default(0)
  embedding    Unsupported("vector(384)")?
  searchVector Unsupported("tsvector")?
  videos       VideoTopic[]

  @@index([label(ops: raw("gin_trgm_ops"))], type: Gin, map: "Topic_label_trgm_idx")
  @@index([searchVector], type: Gin, map: "Topic_searchVector_idx")
}

model VideoTopic {
  videoId String
  topicId String
  weight  Float
  source  String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([videoId, topicId])
  @@index([topicId, weight])
}

// ─────────────────────────── Materialized graph ───────────────────────────

model GraphNode {
  id          String   @id
  type        NodeType
  refId       String
  label       String
  size        Float    @default(1)
  communityId Int?
  attrs       Json     @default("{}")
  version     BigInt
  updatedAt   DateTime @updatedAt

  @@unique([type, refId])
  @@index([version])
}

model GraphEdge {
  id        String   @id
  sourceId  String
  targetId  String
  kind      EdgeKind
  weight    Float
  evidence  Json?
  version   BigInt
  updatedAt DateTime @updatedAt

  @@unique([sourceId, targetId, kind])
  @@index([sourceId, kind, weight])
  @@index([targetId, kind])
  @@index([version])
}

model GraphTombstone {
  id        String   @id @default(cuid())
  kind      String // "node" | "edge"
  refId     String
  version   BigInt
  createdAt DateTime @default(now())

  @@index([version])
}

// ───────────────────────────── Personal layer ─────────────────────────────

model Workspace {
  id          String       @id @default(cuid())
  ownerId     String
  name        String
  description String?
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections Collection[]
  savedViews  SavedView[]
  layouts     NodeLayout[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId])
}

model Collection {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String           @default("#4361FF")
  icon        String           @default("folder")
  sortOrder   Int              @default(0)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, sortOrder])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  nodeId       String
  note         String?
  tags         String[]
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, nodeId])
  @@index([nodeId])
}

model SavedView {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  state       Json
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

model NodeLayout {
  workspaceId String
  nodeId      String
  x           Float
  y           Float
  pinned      Boolean   @default(true)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, nodeId])
}

// ─────────────────────────────────── Ops ──────────────────────────────────

model DiscoveryQuery {
  id               String   @id @default(cuid())
  userId           String?
  query            String
  nicheId          String?
  resultChannelIds String[]
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model IngestionRun {
  id          String    @id @default(cuid())
  kind        String
  targetId    String
  status      String
  unitsUsed   Int       @default(0)
  searchCalls Int       @default(0)
  requestedBy String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  error       String?
  stats       Json      @default("{}")

  @@index([targetId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

model YouTubeConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  googleSub       String
  channelIds      String[]
  accessTokenEnc  String
  refreshTokenEnc String?
  scope           String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiExtraction {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  contentHash String
  model       String
  output      Json
  tokensIn    Int
  tokensOut   Int
  createdAt   DateTime @default(now())

  @@unique([targetType, targetId, contentHash])
}

// ─────────────────────────────── Better Auth ──────────────────────────────

model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  role              Role               @default(USER)
  reducedMotion     Boolean            @default(false)
  defaultLayout     String             @default("global")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  accounts          Account[]
  workspaces        Workspace[]
  discoveryQueries  DiscoveryQuery[]
  youtubeConnection YouTubeConnection?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
