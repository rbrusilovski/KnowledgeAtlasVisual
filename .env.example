# ─── Core infrastructure ──────────────────────────────────────────────
# Postgres 17 + pgvector + pg_trgm (docker compose service "postgres")
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
# Redis 7: cache, quota counters, rate limits, BullMQ, pub/sub
REDIS_URL=redis://localhost:6379
# Key prefix for every Redis key Atlas writes (lets tests use an isolated namespace)
REDIS_PREFIX=atlas
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# ─── Auth (Better Auth) ───────────────────────────────────────────────
# ≥ 32 random chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the web app (used for OAuth callbacks + origin checks)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional OAuth providers (buttons only appear when both values are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that become ADMIN at signup (access to /admin + bull-board)
ADMIN_EMAILS=admin@atlas.local

# ─── Encryption ───────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Key ID written as a ciphertext prefix; on rotation keep the old key as ENCRYPTION_KEY_<OLDID>
ENCRYPTION_KEY_ID=k1

# ─── YouTube Data API v3 ──────────────────────────────────────────────
# fixture = bundled fictional demo dataset (no key needed); live = real API
YOUTUBE_MODE=fixture
# Required when YOUTUBE_MODE=live. Server-side only; never exposed to the browser.
YOUTUBE_API_KEY=
# bucket = search.list has its own 100 calls/day bucket (current docs);
# shared = search.list costs 100 units from the general pool (older docs)
QUOTA_SEARCH_MODEL=bucket
QUOTA_GENERAL_UNITS_PER_DAY=10000
QUOTA_SEARCH_CALLS_PER_DAY=100
# Background jobs stop once a bucket passes this fraction, keeping headroom for users
QUOTA_BACKGROUND_RATIO=0.6
# Per-user daily cap on discovery searches
DISCOVERY_SEARCHES_PER_USER_PER_DAY=20
# Initial ingest depth (newest-first). "Load full history" continues past it.
INGEST_MAX_VIDEOS_PER_CHANNEL=300

# ─── Embeddings ───────────────────────────────────────────────────────
# local = transformers.js all-MiniLM-L6-v2 (downloads ~25 MB once), remote = HTTP provider,
# hash = deterministic feature-hashing fallback (offline/CI; low quality)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# For EMBEDDING_PROVIDER=remote: OpenAI-compatible /embeddings endpoint
EMBEDDING_REMOTE_URL=
EMBEDDING_REMOTE_API_KEY=

# ─── Optional AI (Anthropic) ──────────────────────────────────────────
# When set, enables AI summaries/topic extraction and low-confidence niche re-ranking
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Daily input+output token budget across all AI jobs
AI_DAILY_TOKEN_BUDGET=200000

# ─── Features ─────────────────────────────────────────────────────────
# Google OAuth with youtube.force-ssl for owner captions (needs Google verification in prod)
FEATURE_YOUTUBE_OAUTH=false
# Third-party transcript adapter (interface only). Operator is responsible for YouTube ToS compliance.
TRANSCRIPT_THIRD_PARTY_ENABLED=false
# Minimum confidence for a subniche assignment (best match is always kept, flagged low-confidence)
CLASSIFY_MIN_CONFIDENCE=0.35

# ─── Rate limits ──────────────────────────────────────────────────────
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_DISCOVERY_PER_MIN=10
RATE_LIMIT_CHANNEL_ADDS_PER_HOUR=30
RATE_LIMIT_AI_PER_DAY=50

# ─── Worker ───────────────────────────────────────────────────────────
# Port bull-board listens on (localhost only; proxied through /api/admin/queues for admins)
BULL_BOARD_PORT=3101
# Register recurring job schedulers (scheduler, compliance, stats) on worker boot
WORKER_SCHEDULERS=true
